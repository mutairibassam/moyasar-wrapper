# --- Database ---
DATABASE_URL=postgres://moyasar_ops:dev_password@localhost:5433/moyasar_ops

# --- Secrets ---
KEY_ENCRYPTION_KEY=   # base64 of 32 random bytes: openssl rand -base64 32

# --- Server ---
PORT=8080
COOKIE_SECURE=false   # false for http://localhost; MUST be true behind HTTPS in prod

# --- Dev-only auth shim (never enable in production) ---
DEV_LOGIN=true

# --- OIDC (config-driven: dev points at Keycloak, prod at Entra — env only) ---
# Dev (Keycloak from docker-compose.dev.yml):
OIDC_ISSUER_URL=http://localhost:8081/realms/dev
OIDC_CLIENT_ID=app
OIDC_CLIENT_SECRET=dev-secret
# Redirect URI is the WEB origin (same-origin proxy): the browser only talks to the
# web app, which proxies /api/* to this API. In split-origin dev that is :3000, not
# the API's :8080 — otherwise the post-login redirect + session cookie land on the
# wrong origin. In a single-origin prod deploy both collapse to the same host.
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
OIDC_IDENTITY_CLAIM=sub        # Entra: set to "oid"
OIDC_GROUPS_CLAIM=groups
# Group whose members may sign in. Keycloak emits the group NAME (full.path=false);
# Entra emits the group's object-id GUID — set accordingly.
APP_ACCESS_GROUP_ID=invoice-app-users

# --- Prod (Microsoft Entra ID) would instead be, e.g.: ---
# OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=<app-registration-client-id>
# OIDC_CLIENT_SECRET=<app-registration-secret>
# OIDC_REDIRECT_URI=https://<your-host>/api/v1/auth/callback
# OIDC_IDENTITY_CLAIM=oid
# APP_ACCESS_GROUP_ID=<entra-group-object-id>
